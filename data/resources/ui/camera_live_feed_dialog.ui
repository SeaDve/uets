<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="UetsCameraLiveFeedDialog" parent="AdwDialog">
    <property name="follows-content-size">True</property>
    <property name="presentation-mode">bottom-sheet</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
              <object class="AdwWindowTitle">
                <property name="title">Camera Live Feed</property>
              </object>
            </property>
          </object>
        </child>
        <property name="content">
          <object class="GtkListBox" id="list_box">
            <property name="selection-mode">none</property>
            <style>
              <class name="background"/>
            </style>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
